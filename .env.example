# Copy to .env and change every value before first launch.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data\workload.sqlite3
BACKUP_DIR=backups
SECRET_KEY=replace-with-at-least-32-random-bytes
COOKIE_SECURE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SESSION_HOURS=8
BACKUP_RETENTION_DAYS=30
